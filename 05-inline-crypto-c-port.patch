+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_HISI_INLINE_CRYPTO_H
+#define _LINUX_HISI_INLINE_CRYPTO_H
+
+#include <linux/bio.h>
+#include <linux/blkdev.h>
+
+/* The stock HISI_BLK implementation remains authoritative when enabled. */
+#if defined(CONFIG_SCSI_UFS_INLINE_CRYPTO) && !defined(CONFIG_HISI_BLK)
+void hisi_inline_crypto_req_init(struct request *rq);
+void hisi_inline_crypto_init_request(struct request *rq, const struct bio *bio);
+void hisi_inline_crypto_clone_bio(struct bio *dst, const struct bio *src);
+void hisi_inline_crypto_clone_request(struct request *dst,
+				    const struct request *src);
+void hisi_inline_crypto_advance(struct bio *bio, unsigned int bytes);
+bool hisi_inline_crypto_merge_allow(const struct request *rq,
+				   const struct bio *bio);
+#else
+static inline void hisi_inline_crypto_req_init(struct request *rq) {}
+static inline void hisi_inline_crypto_init_request(struct request *rq,
+						 const struct bio *bio) {}
+static inline void hisi_inline_crypto_clone_bio(struct bio *dst,
+					      const struct bio *src) {}
+static inline void hisi_inline_crypto_clone_request(struct request *dst,
+						  const struct request *src) {}
+static inline void hisi_inline_crypto_advance(struct bio *bio,
+					    unsigned int bytes) {}
+static inline bool hisi_inline_crypto_merge_allow(const struct request *rq,
+						const struct bio *bio)
+{
+	return true;
+}
+#endif
+#endif
