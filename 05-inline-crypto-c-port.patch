+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2020. All rights reserved.
+ * Derived from block/mas_blk_inline_crypt.c in Huawei's kirin970 4.14 tree:
+ * f39fdf340fe2ee29db13cb8838653161d6ad7c57 (hisi-oss mirror).
+ *
+ * This software is licensed under the terms of the GNU General Public
+ * License version 2, as published by the Free Software Foundation.
+ *
+ * Backport for Huawei 4.9 without generated HISI_BLK assembly. Keep the
+ * existing UFS descriptor/key programming and its 64-byte key contract.
+ */
+#include <linux/hisi-inline-crypto.h>
+#include <linux/kernel.h>
+
+#if defined(CONFIG_SCSI_UFS_INLINE_CRYPTO) && !defined(CONFIG_HISI_BLK)
+
+#define HISI_INLINE_KEY_BYTES 64
+
+void blk_queue_set_inline_crypto_flag(struct request_queue *q, bool enable)
+{
+	q->hisi_inline_crypto = enable;
+}
+
+int is_blk_queue_support_crypto(struct request_queue *q)
+{
+	return q->hisi_inline_crypto;
+}
+
+void hisi_inline_crypto_req_init(struct request *rq)
+{
+	rq->hisi_req.ci_key = NULL;
+	rq->hisi_req.ci_key_len = 0;
+	rq->hisi_req.ci_key_index = -1;
+}
+
+void hisi_inline_crypto_init_request(struct request *rq, const struct bio *bio)
+{
+	/* Also reset recycled requests when the incoming BIO is unencrypted. */
+	hisi_inline_crypto_req_init(rq);
+	if (!bio || !bio->hisi_bio.ci_key)
+		return;
+
+	/* The stock 4.9 request initializer treats other lengths as fatal. */
+	BUG_ON(bio->hisi_bio.ci_key_len != HISI_INLINE_KEY_BYTES);
+	rq->hisi_req.ci_key = bio->hisi_bio.ci_key;
+	rq->hisi_req.ci_key_len = bio->hisi_bio.ci_key_len;
+	rq->hisi_req.ci_key_index = bio->hisi_bio.ci_key_index;
+}
+
+void hisi_inline_crypto_clone_bio(struct bio *dst, const struct bio *src)
+{
+	dst->hisi_bio = src->hisi_bio;
+}
+
+void hisi_inline_crypto_clone_request(struct request *dst,
+				    const struct request *src)
+{
+	dst->hisi_req = src->hisi_req;
+}
+
+void hisi_inline_crypto_advance(struct bio *bio, unsigned int bytes)
+{
+	u64 units;
+
+	if (!bio->hisi_bio.ci_key || !bytes || !bio_has_data(bio) ||
+	    bio_no_advance_iter(bio))
+		return;
+
+	/* Called BEFORE the iterator advances. Logical DUNs must also work for
+	 * direct-I/O user pages, whose page->index is not a file block index.
+	 * Retain the DUN for partial-page advancement until a unit is crossed.
+	 */
+	units = ((u64)(bio_offset(bio) & (PAGE_SIZE - 1)) + bytes) >> PAGE_SHIFT;
+	BUG_ON(units > (pgoff_t)-1 - bio->hisi_bio.index);
+	bio->hisi_bio.index += units;
+}
+
+static bool hisi_crypto_whole_units(const struct bio *bio)
+{
+	return bio && bio_has_data((struct bio *)bio) &&
+	       bio->bi_iter.bi_size &&
+	       !(bio->bi_iter.bi_size & (PAGE_SIZE - 1)) &&
+	       !(bio_offset(bio) & (PAGE_SIZE - 1));
+}
+
+static bool hisi_crypto_next_index(const struct bio *left,
+				 const struct bio *right)
+{
+	pgoff_t units;
+
+	/* Conservatively decline merging partial data units; I/O still works
+	 * through separate requests. bi_vcnt is not a count of the remaining
+	 * pages after splitting/trimming a BIO, so use its current byte count.
+	 */
+	if (!hisi_crypto_whole_units(left) || !hisi_crypto_whole_units(right))
+		return false;
+	units = left->bi_iter.bi_size >> PAGE_SHIFT;
+	return units <= (pgoff_t)-1 - left->hisi_bio.index &&
+	       left->hisi_bio.index + units == right->hisi_bio.index;
+}
+
+bool hisi_inline_crypto_merge_allow(const struct request *rq,
+				   const struct bio *bio)
+{
+	if (!bio->hisi_bio.ci_key && !rq->hisi_req.ci_key)
+		return true;
+	if (!bio->hisi_bio.ci_key || !rq->hisi_req.ci_key)
+		return false;
+	if (bio->hisi_bio.ci_key != rq->hisi_req.ci_key ||
+	    bio->hisi_bio.ci_key_len != HISI_INLINE_KEY_BYTES ||
+	    bio->hisi_bio.ci_key_len != rq->hisi_req.ci_key_len ||
+	    bio->hisi_bio.ci_key_index != rq->hisi_req.ci_key_index)
+		return false;
+	if (!rq->bio || !rq->biotail)
+		return false;
+
+	/* Check metadata even on a stacking queue: a lower UFS queue still
+	 * needs the original BIO's key and DUN, independent of queue capability.
+	 */
+	if (blk_rq_pos(rq) + blk_rq_sectors(rq) == bio->bi_iter.bi_sector)
+		return hisi_crypto_next_index(rq->biotail, bio);
+	if (bio->bi_iter.bi_sector + bio_sectors(bio) == blk_rq_pos(rq))
+		return hisi_crypto_next_index(bio, rq->bio);
+	return false;
+}
+#endif
