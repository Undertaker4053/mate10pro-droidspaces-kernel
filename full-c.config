# Based on DroidSpaces non-GKI requirements, adapted for Huawei Linux 4.9.
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_MEMCG=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_CPUACCT=y
# Both controllers declare SUBSYS(pids). Keep the Huawei implementation.
CONFIG_HW_CGROUP_PIDS=y
# CONFIG_CGROUP_PIDS is not set
CONFIG_DEVTMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_FUSE_FS=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_IPV6=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_MACVLAN=y
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# Keep the original KernelSU integration and SELinux configuration.
CONFIG_KSU=y
# CONFIG_KPROBES is not set
CONFIG_SECURITY_SELINUX=y
# CONFIG_SECURITY_SELINUX_DEVELOP is not set
CONFIG_LOCALVERSION="-BLA_EMUI9.1_KernelSU_DSfullC"
# CONFIG_LOCALVERSION_AUTO is not set

# Docker resource controls and common networking backends.
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_VXLAN=y
CONFIG_DUMMY=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_IP_VS=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_NFCT=y
CONFIG_CHECKPOINT_RESTORE=y
# Generated vendor .S uses fixed stock structure layouts; use existing C fallbacks.
# CONFIG_HISI_PAGECACHE_HELPER is not set
# CONFIG_HISI_BLK is not set
# CONFIG_HISI_BK_OPS is not set
# CONFIG_HISI_BLOCK_FREQUENCE_CONTROL is not set
# CONFIG_HISI_UFS_MANUAL_BKOPS is not set
# CONFIG_HUAWEI_UFS_VENDOR_MODE is not set
# CONFIG_SCSI_UFS_HISI_UFS_MQ_DEFAULT is not set
# CONFIG_HW_NETFILTER_MODULE is not set
# CONFIG_DEFAULT_ROW is not set
# CONFIG_IOSCHED_ROW is not set
CONFIG_DEFAULT_DEADLINE=y

# Preserve the stock encrypted filesystem and UFS hardware crypto contract.
CONFIG_SCSI_UFS_INLINE_CRYPTO=y
CONFIG_SCSI_UFS_ENHANCED_INLINE_CRYPTO=y
# CONFIG_SCSI_UFS_ENHANCED_INLINE_CRYPTO_V2 is not set
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_EXT4_ENCRYPTION=y
